# Copy this file to .env and fill in your values
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: RateHawk API credentials (requires backend proxy - see src/utils/ratehawk.js)
# VITE_RATEHAWK_KEY_ID=your-ratehawk-key-id
# VITE_RATEHAWK_API_KEY=your-ratehawk-api-key
# VITE_RATEHAWK_API_URL=https://api.worldota.net/api/b2b/v3

# ── LiteAPI flight search ───────────────────────────────────────────────
# The flight UI shows demo data until the serverless proxy (api/flights.js)
# has a key. Set this ONE variable in your host's environment settings
# (Vercel/Netlify dashboard) — it stays server-side and is never exposed to
# the browser. This is the only thing you need for live flight prices.
LITEAPI_KEY=sand_your-liteapi-sandbox-or-private-key
#
# Optional: only if your proxy lives at a different URL than /api/flights.
# VITE_FLIGHTS_API_URL=https://your-backend.example.com/api/flights
