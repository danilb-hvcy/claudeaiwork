# Copy this file to .env and fill in your values
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: RateHawk API credentials (requires backend proxy - see src/utils/ratehawk.js)
# VITE_RATEHAWK_KEY_ID=your-ratehawk-key-id
# VITE_RATEHAWK_API_KEY=your-ratehawk-api-key
# VITE_RATEHAWK_API_URL=https://api.worldota.net/api/b2b/v3

# Optional: LiteAPI flight search (see src/utils/liteApi.js)
# The flight UI uses bundled mock data until VITE_FLIGHTS_API_URL points at a
# backend proxy that forwards to LiteAPI. Never expose a private/sandbox key
# in the browser — keep it server-side in your proxy.
# VITE_FLIGHTS_API_URL=https://your-backend.example.com/api/flights/search
# VITE_LITEAPI_PUBLIC_KEY=your-liteapi-public-key
