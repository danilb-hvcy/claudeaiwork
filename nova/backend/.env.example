# =============================================================================
# Nova backend environment — copy to .env and fill in REAL values locally.
# .env is gitignored. NEVER commit real secrets. All values below are
# placeholders. Rotate any key that has ever been pasted into a chat/prompt.
# =============================================================================

NODE_ENV=production
PORT=3000

# Public URLs (used for CORS + links). For local dev use http://localhost:5173 etc.
FRONTEND_URL=https://nova.heyvacay.co
API_URL=https://api.nova.heyvacay.co
WS_URL=wss://nova.heyvacay.co

# Port the WebSocket server listens on (proxied to WS_URL in production).
WS_PORT=8080

# --- Zoom Phone (Server-to-Server OAuth app) ---------------------------------
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
# Secret token from the app's Event Subscription page (used for HMAC verify).
ZOOM_WEBHOOK_SECRET=your-zoom-webhook-secret-token

# --- AssemblyAI (speech-to-text) ---------------------------------------------
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# --- Crisp (live chat) -------------------------------------------------------
CRISP_WEBSITE_ID=your-crisp-website-id
CRISP_API_USER_ID=your-crisp-api-user-id
CRISP_API_TOKEN=your-crisp-api-token

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Service role key on the server (NOT the publishable/anon key) so it can write.
SUPABASE_KEY=your-supabase-service-role-key

# --- Anthropic (Claude — backend only, never expose to the browser) ----------
ANTHROPIC_API_KEY=sk-ant-your-key-here
